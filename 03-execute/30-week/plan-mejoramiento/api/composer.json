{
    "name": "a03/lab-equipment",
    "description": "API de préstamo de equipos de laboratorio",
    "type": "project",
    "require": { "php": "^8.4", "laravel/framework": "^12.0" },
    "require-dev": { "phpunit/phpunit": "^11.5" },
    "autoload": { "psr-4": { "App\\": "app/", "Lab\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": { "test": "phpunit" },
    "config": { "sort-packages": true, "optimize-autoloader": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
